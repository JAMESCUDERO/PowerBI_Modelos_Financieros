TT2% =
var res1= CALCULATE([Balance_Signo],ALLSELECTED('Data Estados'[Nivel 3 Modificado]))
var resfin = DIVIDE([Balance_Signo],res1,1)
RETURN
resfin

BALANCE tt =
VAR ACTIVOS = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),'DATA ESTADOS'[NIVEL 1]="Activos")
var PASIVOS = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),'DATA ESTADOS'[NIVEL 1]="Pasivos")
//var PATRIMONIO = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),'DATA ESTADOS'[NIVEL 1]="Patrimonio")
var PATRIMONIO = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),or('Data Estados'[dos digitos]="60",'Data Estados'[dos digitos]="61"))
RETURN
ACTIVOS+PASIVOS+PATRIMONIO

Pasivos Corrientes =
var num_1 = SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO])
VAR COD_212_213 = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),FILTER('DATA ESTADOS',AND('Data Estados'[NUM CODIGO]>=21200
                                                            ,'Data Estados'[NUM CODIGO]<21400)))
RETURN
COD_212_213

Activos Corrientes =
CALCULATE(SUM('DATA ESTADOS'[MONTO]),FILTER('DATA ESTADOS',and('Data Estados'[NUM CODIGO]>=13000,'Data Estados'[NUM CODIGO]<14000)))+[Activos Operacionales]

Activos Operacionales =
CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),FILTER('DATA ESTADOS',and('Data Estados'[NUM CODIGO]>=11000,'Data Estados'[NUM CODIGO]<12000)))

Indice Corriente =
DIVIDE([Activos Corrientes],[Pasivos Corrientes],1)*(-1)

indice corriente text 2 =
"El activo corriente representa "& ROUND([Indice Corriente],2) &" veces el pasivo corriente.

" &
    "Significa que por cada dólar que "&CONCATENATEX('Lista EP','Lista EP'[INSTITUCIÓN])&" adeudaba a corto plazo, contaba con $" & ROUND([Indice Corriente],2) &" en el activo corriente."

Ejecución de Gastos de Inversión =
var devengado = CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),FILTER('Data Presupuesto','Data Presupuesto'[ORDEN]=7))
var codificadio = CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[PRESUPUESTO CODIFICADO]),FILTER('Data Presupuesto','Data Presupuesto'[ORDEN]=7))
var valor = DIVIDE(devengado,codificadio,0)
var imprimir = IF(valor=0,"-",valor)

return 
DIVIDE(devengado,codificadio,0)

Ejecución gasto inversión text =
"Mide el desempeño de los gastos de inversión.

El valor de " &ROUND([Ejecución de Gastos de Inversión]*100,2) & "% demuestra la capacidad organizacional de "&CONCATENATEX('Lista EP','Lista EP'[INSTITUCIÓN])&" para ejecutar las obligaciones de inversión social."

Capital de trabajo text =
"El activo corriente representa "  & ROUND([liquidez],2) &" veces al Pasivo Corriente. 

Significa que por cada dólar que "&CONCATENATEX('Lista EP','Lista EP'[INSTITUCIÓN])&" adeuda en el corto plazo, dispone de $" & ROUND([liquidez],2)  & " para cubrir sus obligaciones a corto plazo."

Ingresos Propios =
var num = SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO])
var cod_621 = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),FILTER('DATA ESTADOS',AND('DATA ESTADOS'[NUM CODIGO]>=62100
                                                    ,'Data Estados'[NUM CODIGO]<62200)))
var COD_623_624_625 = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),FILTER('DATA ESTADOS',AND('DATA ESTADOS'[NUM CODIGO]>=62300
                                                    ,'DATA ESTADOS'[NUM CODIGO]<62600)))                                                    
RETURN

(cod_621 + COD_623_624_625)*(-1)

Ingresos Totales =
var num = SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO])
var numer1 = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),FILTER('DATA ESTADOS',AND('Data Estados'[NUM CODIGO]>=62000
                                                    ,'Data Estados'[NUM CODIGO]<63000)))
RETURN
numer1*(-1)

ENDEUDAMIENTO Text =
"El indice de endeudamiento es de " & ROUND([Endeudamiento]*100,2) & "% para  "&CONCATENATEX('Lista EP','Lista EP'[INSTITUCIÓN])&" es la proporción de activos que se financian con deuda (total de pasivo).

Es decir, que de cada dólar en activos $"& TRUNC([Endeudamiento],2) &" corresponde a deuda."

Medida =
CONCATENATEX('Lista EP','Lista EP'[INSTITUCIÓN])

Dependencia Financiera =
var cod_62601 = -CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]), FILTER('Data Estados','Data Estados'[NUM CODIGO]=62601))
var cod_62621 =  -CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]), FILTER('Data Estados','Data Estados'[NUM CODIGO]=62621))
var ingresos = -CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados','Data Estados'[dos digitos]="62"))
VAR IN_mun = (cod_62601+cod_62621)
var numerador =ingresos-(cod_62601+cod_62621)

RETURN

1-DIVIDE(ingresos-IN_mun,ingresos,0)

liquidez =
var deuda_flotante = -CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados','Data Estados'[dos digitos]="21"))


RETURN

DIVIDE([Activos Operacionales],deuda_flotante,0)

LIQUI CONSO TEXT =
"El activo corriente representa "  & ROUND([liquidez],2) &" veces al Pasivo Corriente. 

Significa que por cada dólar que adeudado en el corto plazo, dispone de $" & ROUND([liquidez],2) & " para cubrir sus obligaciones a corto plazo."

