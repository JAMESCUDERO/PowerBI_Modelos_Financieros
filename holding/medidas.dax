Endeudamiento =
var pasivos = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados',and('Data Estados'[NUM CODIGO]>=20000,'Data Estados'[NUM CODIGO]<30000)))*(-1)

var activo = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados',('Data Estados'[NUM CODIGO]<20000)))
