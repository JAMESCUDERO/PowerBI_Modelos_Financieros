var res_fin= DIVIDE([Balance_Signo],res1,0)
RETURN

res_fin

Ingresos asignaciones =
var cod_62601 = -CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]), FILTER('Data Estados','Data Estados'[NUM CODIGO]=62601))
var cod_62621 =  -CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]), FILTER('Data Estados','Data Estados'[NUM CODIGO]=62621))
var ingresos = -CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados','Data Estados'[dos digitos]="62"))
VAR IN_mun = (cod_62601+cod_62621)
RETURN
IN_mun

// ============================ Tabla: MET ============================

Devengado COM =
CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),'Data Presupuesto'[NIVEL 0]="Gastos",'Data Presupuesto','Data Presupuesto'[COMPUTABLE] = "S")

Devengado COM % =
DIVIDE([Devengado COM],[Devengado],0)

Codificado COM =
CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[PRESUPUESTO CODIFICADO]),'Data Presupuesto','Data Presupuesto'[NIVEL 0]="Gastos",'Data Presupuesto','Data Presupuesto'[COMPUTABLE]="S")

Codificado COM % =
DIVIDE([Codificado COM],[Codificado],0)

