VAR TEXTO = IF(FILTRO=0,"",FILTRO)
RETURN
TEXTO

MONTO_POR_TRANS =
VAR CONTADOR = SUMX('Transferencias','Transferencias'[MONTO POR TRANSFERIR])
VAR fILTRO = CALCULATE(SUMX('Transferencias','Transferencias'[MONTO POR TRANSFERIR]),'Transferencias'[VIGENCIA]="ACTUAL")

RETURN
