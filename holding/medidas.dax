Ranking SB =
RANKX(ALLSELECTED('Lista EP'[LOGO]),[Bancos])

Ranking IN =
RANKX(ALLSELECTED('Lista EP'[LOGO]),[inversiones_des])

Codificado =
CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[PRESUPUESTO CODIFICADO]),FILTER('Data Presupuesto','Data Presupuesto'[NIVEL 0]="Gastos"))

Devengado =
CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),'Data Presupuesto'[NIVEL 0]="Gastos")

texto_ER =
var texto_1 =IF([Resultado_ejer]>0,"Superavit ","Deficit")
var id_text =CONCATENATEX('Lista EP','Lista EP'[ID])
var id_num =CONVERT(id_text,INTEGER)
var imprimir = IF(id_num>8,texto_1,"Dependiente")
return
"Resultado del Ejercicio"

nota01 =
var texto = CALCULATE(CONCATENATEX('Data Presupuesto','Data Presupuesto'[NOMBRE DE LA PARTIDA]),'Data Presupuesto'[PARTIDA PRESUPUESTARIA] ="999991")
return
IF(texto="","","- "&texto)

nota02 =
var texto = CALCULATE(CONCATENATEX('Data Presupuesto','Data Presupuesto'[NOMBRE DE LA PARTIDA]),'Data Presupuesto'[PARTIDA PRESUPUESTARIA] ="999992")

return
IF(texto="","","- "&texto)

inversiones_val =
var VAL= IF([inversiones_des]=0,"",[inversiones_des])

return
VAL

Codificado_INGRESO =
CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[PRESUPUESTO CODIFICADO]),FILTER('Data Presupuesto','Data Presupuesto'[NIVEL 0]="Ingresos"))

Devengado_ingresos =
CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),'Data Presupuesto'[NIVEL 0]="Ingresos")

Ejecución ingreso =
var deven = [Devengado_ingresos]
var codif = [Codificado_INGRESO]
return 
DIVIDE(deven,codif,0)

TT_DEVEN_INGRESO =
CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),FILTER('Data Presupuesto','Data Presupuesto'[NIVEL 0]="Ingresos"))

