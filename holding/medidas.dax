return
IF(texto="","","- "&texto)

inversiones_des =
var inver1 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados','Data Estados'[CÓDIGO CONTABLE]="111.51"))
var inver2 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados','Data Estados'[CÓDIGO CONTABLE]="121.01"))
var inver3 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados','Data Estados'[CÓDIGO CONTABLE]="121.03"))
var inver4 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados','Data Estados'[CÓDIGO CONTABLE]="121.05"))
var inver5 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),FILTER('Data Estados','Data Estados'[CÓDIGO CONTABLE]="121.07"))
return
inver1 +inver2 +inver3 + inver4 + inver5

FECHA_INICIO =
VAR FECHA = CONCATENATEX('Transferencias','Transferencias'[FECHA INICIO DE CONVENIO])
