VERIFIC_PRESU1 =
VAR CODIF=SUMX('Data Presupuesto','Data Presupuesto'[PRESUPUESTO CODIFICADO])

VAR CERTI=SUMX('Data Presupuesto','Data Presupuesto'[CERTIFICADO])

Var fin = IF( ROUND(CERTI,0)<= ROUND(CODIF,0) ,"OK","ERROR")

RETURN
fin

VERIFIC_PRESU2 =
VAR COMPROME = SUMX('Data Presupuesto','Data Presupuesto'[COMPROMETIDO])

VAR CERTIF=SUMX('Data Presupuesto','Data Presupuesto'[CERTIFICADO])

Var fin = IF(ROUND(COMPROME,0)>ROUND(CERTIF,0),"ERROR","OK")

RETURN
fin

VERIFIC_PRESU3 =
VAR COMPROME = SUMX('Data Presupuesto','Data Presupuesto'[COMPROMETIDO])

VAR DEVEB=SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO])

Var fin = IF(ROUND(COMPROME,0)<round(DEVEB,0),"ERROR","OK")

RETURN
fin

VERIFIC_PRESU4 =
VAR CODIF = ROUND(SUMX('Data Presupuesto','Data Presupuesto'[PRESUPUESTO CODIFICADO]),0)

VAR CERTI = ROUND(SUMX('Data Presupuesto','Data Presupuesto'[CERTIFICADO]),0)

VAR COMPROME = ROUND(SUMX('Data Presupuesto','Data Presupuesto'[COMPROMETIDO]),0)

VAR DEVENGAD=ROUND(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),0)

Var fin = IF(OR(CODIF<CERTI,OR(CODIF<COMPROME,CODIF<DEVENGAD)),"ERROR","OK")

RETURN
fin

VERIFIC_PRESU5 =
VAR CODIFICADO_1 = ROUND(SUMX('Data Presupuesto','Data Presupuesto'[COMPROMETIDO]),0)

VAR DEVEB=ROUND(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),0)

VAR PAGADO_1 = ROUND(SUMX('Data Presupuesto','Data Presupuesto'[PAGADO]),0)
Var fin = IF(OR(PAGADO_1>CODIFICADO_1,PAGADO_1>DEVEB),"ERROR","OK")


RETURN
fin

UNIFICADO =
IF(OR([VERIFIC_PRESU1]="ERROR",OR([VERIFIC_PRESU2]="ERROR",OR([VERIFIC_PRESU3]="ERROR",OR([VERIFIC_PRESU4]="ERROR",[VERIFIC_PRESU5]="ERROR")))),"ERROR","OK")

