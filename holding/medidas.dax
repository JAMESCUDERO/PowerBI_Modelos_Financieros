// Medidas DAX del modelo (98 en total), extraidas del .pbix y agrupadas por tabla.

// ============================ Tabla: DAX ============================

DAX cantidad de convenios =
VAR CONTADOR = COUNT('Transferencias'[ID])
VAR FILTRADO = CALCULATE(COUNT('Transferencias'[ID]),'Transferencias'[VIGENCIA]="ANTERIOR")
RETURN
FILTRADO-0

Activos =
CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[NIVEL 1]="Activos")

Pasivos =
CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[NIVEL 1]="Pasivos")

Patrimonio =
CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[NIVEL 1]="Patrimonio")

monto aa =
CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),DATEADD('date'[Fecha],-12,MONTH))

monto ma =
CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),DATEADD('date'[Fecha],-1,MONTH))

BALANCE =
VAR ACTIVOS = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),'DATA ESTADOS'[NIVEL 1]="Activos")
var PASIVOS = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),'DATA ESTADOS'[NIVEL 1]="Pasivos")
//var PATRIMONIO = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),'DATA ESTADOS'[NIVEL 1]="Patrimonio")
var PATRIMONIO = CALCULATE(SUMX('DATA ESTADOS','DATA ESTADOS'[MONTO]),or('Data Estados'[dos digitos]="60",'Data Estados'[dos digitos]="61"))
RETURN
ACTIVOS-PASIVOS-PATRIMONIO

Ejecución Presupuestaria =
var deven = [Devengado]
var codif = [Codificado]
return 
DIVIDE(deven,codif,0)

Ranking EP =
RANKX(ALLSELECTED('Lista EP'[LOGO]),[Ejecución Presupuestaria])

Bancos =
var valor = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[NIVEL 3]= "Efectivo y Equivalente de Efectivo")

var exclu_111_01 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[CÓDIGO CONTABLE]= "111.01")

var exclu_111_31 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[CÓDIGO CONTABLE]= "111.31")

var exclu_111_33 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[CÓDIGO CONTABLE]= "111.33")

var exclu_111_35 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[CÓDIGO CONTABLE]= "111.35")

var exclu_111_51 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[CÓDIGO CONTABLE]= "111.51")

var exclu_111_53 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[CÓDIGO CONTABLE]= "111.53")
RETURN
valor-( exclu_111_01+exclu_111_31+exclu_111_33+exclu_111_35+exclu_111_51+exclu_111_53)

Inversiones =
var valor_121 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[NIVEL 3]= "Inversiones Temporales")
var valor_122 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[NIVEL 3]= "Inversiones Permanentes en Títulos y Valores")
var valor_123 = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[NIVEL 3]= "Inversiones en Préstamos y Anticipos")
var resultado1= valor_121 + valor_122 + valor_123
return
resultado1-0

Pre % deven =
//devengado porcentaje y peso 

var deven = SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO])
var codif =CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),ALL('Data Presupuesto'[NIVEL PROPIO]))
return 
DIVIDE(deven,codif,0)

ingresos_res =
CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[dos digitos]="62")*(-1)

Resultado_ejer =
(CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[dos digitos]="63")*(-1)) + (CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[dos digitos]="62")*(-1))

texto_1 =
IF([Resultado_ejer]>0,"Superavit ","Deficit")

Cuentas Por Cobrar =
var fin = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[NIVEL 3] = "Cuentas por Cobrar")
return
fin

Cuentas Por Pagar =
var fin = CALCULATE(SUMX('Data Estados','Data Estados'[MONTO]),'Data Estados'[NIVEL 3] = "Cuentas por Pagar")
var val = fin*(-1)
var imprimir = IF(val=0,"-",val)
return
imprimir

Etiqueta de pasivo =
var pasivo = -[Pasivos]
var resto = [Activos]
var texto_f = IF(pasivo<resto*(0.20),"Pasivos: $ ","")
var valor_f = IF(pasivo<resto*(0.20),pasivo,"")
RETURN
valor_f

color_ ejecución =
[Ejecución Presupuestaria] / SUMX('Proyección','Proyección'[Proyectado])

Balance_Signo =
IF(SUMX('Data Estados','Data Estados'[MONTO])>0,SUMX('Data Estados','Data Estados'[MONTO]),SUMX('Data Estados','Data Estados'[MONTO])*(-1))

Variacion_aa =
SUMX('Data Estados','Data Estados'[MONTO])-[monto aa]

Variacion_%_MA_BG =
var res1=SUMX('Data Estados','Data Estados'[MONTO])-[monto ma]
return
DIVIDE(res1,[monto ma],1)

Variacion_MA =
SUMX('Data Estados','Data Estados'[MONTO])-[monto ma]

TTI_%_PR =
var res1= CALCULATE(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),ALLSELECTED('Data Presupuesto'[NIVEL 6 ]))

var resfin = DIVIDE(SUMX('Data Presupuesto','Data Presupuesto'[DEVENGADO]),res1,1)
