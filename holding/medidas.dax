DAX_FECHA_FIN_CONV =
VAR FECHA = IF(CONCATENATEX('Transferencias','Transferencias'[FECHA FIN DE CONVENIO])= "Hasta el cumplimiento del objeto"," Al Cumplimiento",CONCATENATEX('Transferencias','Transferencias'[FECHA FIN DE CONVENIO]))
VAR TEXTO = IF(FECHA="","-",FECHA)

RETURN
